MONGO_URI=mongodb://127.0.0.1:27017/aralna
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
PORT=5000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local development: use a Gmail App Password, not your regular Google password.
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gmail API: alternatively select EMAIL_PROVIDER=gmail-api and provide OAuth credentials.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=

# Render production: select Brevo and set these in the Render service environment.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=your-verified-sender@example.com
# BREVO_FROM_NAME=AralNa
